# EdgeX Device MQTT Service Environment Variables

# Device service repository
DEVICE_SVC_REPOSITORY=edgexfoundry

# Architecture suffix (empty for amd64, "-arm64" for arm64)
ARCH=

# Device MQTT version
DEVICE_MQTT_VERSION=3.0.0

# Command flags (optional)
CP_FLAGS=

# User and group IDs for security
EDGEX_USER=2002
EDGEX_GROUP=2001
